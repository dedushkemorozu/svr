{"title": "Главная", "slug": "glavnaya", "status": "publish", "template": "page-no-title", "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"rida-hero rida-py\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull rida-hero rida-py\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"align\":\"wide\",\"className\":\"rida-hero__cols\"} -->\n<div class=\"wp-block-columns alignwide are-vertically-aligned-center rida-hero__cols\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"52%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:52%\"><!-- wp:paragraph {\"className\":\"rida-eyebrow rida-in\"} -->\n<p class=\"rida-eyebrow rida-in\">Мастерская «Рида» · Москва · с 2012 года</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"rida-in\"} -->\n<h1 class=\"wp-block-heading rida-in\">Сказочные игрушки <em>ручной росписи</em></h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"rida-lead rida-in\"} -->\n<p class=\"rida-lead rida-in\">Деревянные ангелы-хранители, домики-вазы, маяки, птицы и лошадки. Каждую деталь мы рисуем вручную — штрих за штрихом, поэтому двух одинаковых игрушек не бывает.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"className\":\"rida-in\"} -->\n<div class=\"wp-block-buttons rida-in\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rida-art.ru/shop/\">Смотреть каталог</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rida-art.ru/brand/\">О мастерской</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:html -->\n<p class=\"rida-trust rida-in\"><span>Только ручная роспись</span><span>Натуральное дерево</span><span>Доставка по всей России</span></p>\n<!-- /wp:html --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"48%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:48%\"><!-- wp:html -->\n<div class=\"rida-art\">\n<figure class=\"a1\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/72aacbb9-f747-43c9-ac8d-fb4c81ac426e-16554635-768x768.jpeg\" srcset=\"https://rida-art.ru/wp-content/uploads/2026/10/72aacbb9-f747-43c9-ac8d-fb4c81ac426e-16554635-600x600.jpeg 600w, https://rida-art.ru/wp-content/uploads/2026/10/72aacbb9-f747-43c9-ac8d-fb4c81ac426e-16554635-768x768.jpeg 768w, https://rida-art.ru/wp-content/uploads/2026/10/72aacbb9-f747-43c9-ac8d-fb4c81ac426e-16554635-1024x1024.jpeg 1024w\" sizes=\"(max-width:781px) 60vw, 330px\" alt=\"Ангел Чудес — деревянный ангел ручной росписи с месяцем и китом\" width=\"768\" height=\"768\" fetchpriority=\"high\"></figure>\n<figure class=\"a2\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/c692e087-802b-463b-a564-66b853613574-16924691-600x600.jpeg\" alt=\"Деревянный домик-ваза «У моря» ручной росписи\" width=\"600\" height=\"600\"></figure>\n<figure class=\"a3\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/daf9feb4-6380-466b-bd3f-de2aa843f34d-16554749-600x600.jpeg\" alt=\"Маяк-ночник из дерева с ручной росписью\" width=\"600\" height=\"600\"></figure>\n<span class=\"rida-star s1\" aria-hidden=\"true\">✦</span><span class=\"rida-star s2\" aria-hidden=\"true\">✦</span><span class=\"rida-star s3\" aria-hidden=\"true\">✦</span>\n<div class=\"rida-badge\"><span>Каждая —<br>в одном<br>экземпляре</span></div>\n</div>\n<!-- /wp:html --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:html -->\n<div class=\"rida-marquee alignfull\" aria-hidden=\"true\"><div class=\"rida-marquee__track\"><span>Ангелы-хранители</span><span>Домики-вазы</span><span>Маяки</span><span>Мезенская роспись</span><span>Гуси и птицы</span><span>Лошадки-качалки</span><span>Грибы и жёлуди</span><spa