tent/uploads/2026/10/3b66494c-b218-410f-86ce-8e695ba781e6-16554724-600x600.jpeg\" alt=\"Деревянные маяки ручной росписи\" loading=\"lazy\" width=\"600\" height=\"600\"><span class=\"rida-cat__t\"><b>Маяки</b><i>↗</i></span></a>\n<a class=\"rida-cat\" href=\"https://rida-art.ru/product-category/birds/\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/41e3b36b-c432-4e72-b43e-fbe34c9b3f69-14738688-600x600.jpeg\" alt=\"Расписные гуси и птицы\" loading=\"lazy\" width=\"600\" height=\"600\"><span class=\"rida-cat__t\"><b>Птицы</b><i>↗</i></span></a>\n<a class=\"rida-cat\" href=\"https://rida-art.ru/product-category/horse/\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/e2aefddc-1152-4543-9cd7-b160243c1545-14954412-600x600.jpeg\" alt=\"Лошадки-качалки ручной росписи\" loading=\"lazy\" width=\"600\" height=\"600\"><span class=\"rida-cat__t\"><b>Лошадки</b><i>↗</i></span></a>\n<a class=\"rida-cat\" href=\"https://rida-art.ru/product-category/mush/\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/56ea8b03-c03c-404a-a4f6-38f56cece1ec-14738854-600x600.jpeg\" alt=\"Деревянные грибы и жёлуди\" loading=\"lazy\" width=\"600\" height=\"600\"><span class=\"rida-cat__t\"><b>Грибы и жёлуди</b><i>↗</i></span></a>\n<a class=\"rida-cat\" href=\"https://rida-art.ru/product-category/nabory/\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/1be0fd24-731c-4fd5-982a-0471db175eae-14738728-600x600.jpeg\" alt=\"Подарочные наборы с мезенской росписью\" loading=\"lazy\" width=\"600\" height=\"600\"><span class=\"rida-cat__t\"><b>Наборы</b><i>↗</i></span></a>\n<a class=\"rida-cat\" href=\"https://rida-art.ru/product-category/spring/\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/f3097cd1-93ed-48b5-8029-41ee88742cc4-16205896-600x600.jpeg\" alt=\"Пасхальные яйца с росписью\" loading=\"lazy\" width=\"600\" height=\"600\"><span class=\"rida-cat__t\"><b>Пасха</b><i>↗</i></span></a>\n</nav>\n<!-- /wp:html --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"rida-pb\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide rida-pb\"><!-- wp:group {\"className\":\"rida-section-head rida-reveal\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group rida-section-head rida-reveal\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\"} -->\n<p class=\"rida-eyebrow\">Любимые работы</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Хиты <em>мастерской</em></h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"rida-link-arrow\"} -->\n<p class=\"rida-link-arrow\"><a href=\"https://rida-art.ru/shop/\">Все игрушки</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:woocommerce/product-collection {\"queryId\":11,\"query\":{\"perPage\":8,\"pages\":1,\"offset\":0,\"postType\":\"product\",\"order\":\"desc\",\"orderBy\":\"date\",\"search\":\"\",\"exclude\":[],\"inherit\":false,\"taxQuery\":{},\"isProductCollectionBlock\":true,\"featured\":true,\"woocommerceOnSale\":false,\"woocommerceStockStatus\":[\"instock\",\"onbackorder\"],\"woocommerceAttributes\":[],\"woocommerceHandPickedProducts\":[]},\"tagName\":\"div\",\"displayLayout\":{\"type\":\"flex\",\"columns\":4,\"shrinkColumns\":true},\"dimensions\":{\"widthType\":\"fill\"},\"collection\":\"woocommerce/product-collection/featured\",\"hideControls\":[\"inherit\",\"featured\"],\"queryContextIncludes\":[\"collection\"]} -->\n<div class=\"wp-block-woocommerce-product-collection\"><!-- wp:woocommerce/product-template -->\n<!-- wp:woocommerce/product-image {\"showSaleBadge\":false,\"imageSizing\":\"thumbnail\",\"isDescendentOfQueryLoop\":true} -->\n<!-- wp:woocommerce/product-sale-badge {\"isDescendentOfQueryLoop\":true,\"align\":\"right\"} /-->\n<!-- /wp:woocommerce/product-image -->\n\n<!-- wp:post-title {\"textAlign\":\"center\",\"level\":3,\"isLink\":true,\"__woocommerceNamespace\":\"woocommerce/product-collection/product-title\"} /-->\n\n<!-- wp:woocommerce/product-price {\"isDescendentOfQueryLoop\":true,\"textAlign\":\"center\"} /-->\n\n<!-- wp:woocommerce/product-button {\"textAlign\":\"center\",\"isDescendentOfQueryLoop\":true} /-->\n<!-- /wp:woocommerce/product-template --></div>\n<!-- /wp:woocommerce/product-collection --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"rida-story rida-py\",\"backgroundColor\":\"accent-2\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull rida-story rida-py has-accent-2-background-color has-background\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"clamp(2rem,6vw,6rem)\"}}}} -->\n<div class=\"wp-block-columns alignwide are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"42%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:42%\"><!-- wp:image {\"id\":308,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"rida-arch\"} -->\n<figure class=\"wp-block-image size-full rida-arch\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/master-rida.jpg\" alt=\"Автор игрушек в мастерской «Рида» в Москве\" class=\"wp-image-308\" loading=\"lazy\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"58%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:58%\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\"} -->\n<p class=\"rida-eyebrow\">О мастерской</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"clamp(2rem,3.6vw,3.2rem)\"}}} -->\n<h2 class=\"wp-block-heading\" style=\"font-size:clamp(2rem,3.6vw,3.2rem)\">Каждую игрушку рисует <em>одна пара рук</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"rida-lead\"} -->\n<p class=\"rida-lead\">Всё, что вы видите на сайте, я сочиняю и рисую сама. Даже самая маленькая деталь — глаза ангела, окошко домика, пёрышко гуся — прорисовывается кистью, штрих за штрихом. К каждой работе прикасаюсь сердцем, чтобы она получилась душевной и сказочной.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Мы работаем с натуральным деревом и безопасными красками, а игрушки собираем в сезонные коллекции, которые обновляются четыре раза в год: весной — пасхальные ангелы и расписные яйца, осенью — грибы и жёлуди, к Новому году — праздничный декор. Наши игрушки очень добрые, и мы верим, что в каждый новый дом они принесут искорку счастья и уюта.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"rida-sign\"} -->\n<p class=\"rida-sign\">— мастерская «Рида»</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rida-art.ru/brand/\">Подробнее о мастерской</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"rida-py\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide rida-py\"><!-- wp:group {\"className\":\"rida-section-head rida-reveal\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group rida-section-head rida-reveal\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\"} -->\n<p class=\"rida-eyebrow\">Почему «Рида»</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Подарок, который <em>не потеряется</em></h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:html -->\n<div class=\"rida-features\">\n<div class=\"rida-feature\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M30 6l12 12-18 18H12V24z\"/><path d=\"M26 10l12 12\"/><path d=\"M12 36c-4 0-6 3-6 6 4 0 8-1 9-4\"/></svg><h3>Только ручная роспись</h3><p>Никаких наклеек и принтов: каждый узор, лицо и окошко нарисованы кистью.</p></div>\n<div class=\"rida-feature\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 38C10 20 22 10 40 8c-2 18-12 30-30 30z\"/><path d=\"M10 38l16-16\"/></svg><h3>Натуральные материалы</h3><p>Дерево, стекло и фарфор, безопасные краски — игрушки можно дарить детям.</p></div>\n<div class=\"rida-feature\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M24 5l5 12 13 1-10 8 3 13-11-7-11 7 3-13-10-8 13-1z\"/></svg><h3>В единственном экземпляре</h3><p>Работы не повторяются один в один — ваша игрушка будет только вашей.</p></div>\n<div class=\"rida-feature\"><svg viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 16l18-9 18 9v16l-18 9-18-9z\"/><path d=\"M6 16l18 9 18-9M24 25v16\"/></svg><h3>Бережная доставка</h3><p>Аккуратно упакуем и отправим по всей России. В Москве — самовывоз из мастерской.</p></div>\n</div>\n<!-- /wp:html --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"rida-night rida-py\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull rida-night rida-py\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"clamp(2rem,6vw,6rem)\"}}}} -->\n<div class=\"wp-block-columns alignwide are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"50%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:50%\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\"} -->\n<p class=\"rida-eyebrow\">Коллекция «Маяки»</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"clamp(2.2rem,4vw,3.6rem)\"}}} -->\n<h2 class=\"wp-block-heading\" style=\"font-size:clamp(2.2rem,4vw,3.6rem)\">Ангелы, которые <em>освещают</em> дорогу домой</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"rida-lead\"} -->\n<p class=\"rida-lead\">Маяк — древний символ надежды и возвращения. На платьях наших ангелов светят маяки, плывут киты и мерцают звёзды над ночным морем. Такой ангел становится тихим хранителем дома и прекрасным подарком тем, кого вы ждёте.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"rida-btn-gold\"} -->\n<div class=\"wp-block-button rida-btn-gold\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rida-art.ru/product-category/angels/\">Выбрать ангела</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rida-art.ru/product-category/mayak/\" style=\"color:#efe7d8\">Все маяки</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"50%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:50%\"><!-- wp:html -->\n<div class=\"rida-night-art\"><figure class=\"n1\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/angely-s-mayakami.jpg\" alt=\"Ангелы с маяками ручной росписи на синем фоне\" loading=\"lazy\" width=\"864\" height=\"864\"></figure><figure class=\"n2\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/angel-mayak-sinij.jpg\" alt=\"Синий ангел с маяком\" loading=\"lazy\" width=\"864\" height=\"864\"></figure></div>\n<!-- /wp:html --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"rida-py\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide rida-py\"><!-- wp:group {\"className\":\"rida-section-head rida-reveal\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group rida-section-head rida-reveal\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\"} -->\n<p class=\"rida-eyebrow\">Только что из мастерской</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\"><em>Новинки</em> сезона</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"rida-link-arrow\"} -->\n<p class=\"rida-link-arrow\"><a href=\"https://rida-art.ru/product-category/new/\">Все новинки</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:woocommerce/product-collection {\"queryId\":12,\"query\":{\"perPage\":4,\"pages\":1,\"offset\":0,\"postType\":\"product\",\"order\":\"desc\",\"orderBy\":\"date\",\"search\":\"\",\"exclude\":[],\"inherit\":false,\"taxQuery\":{\"product_cat\":[17]},\"isProductCollectionBlock\":true,\"featured\":false,\"woocommerceOnSale\":false,\"woocommerceStockStatus\":[\"instock\",\"onbackorder\"],\"woocommerceAttributes\":[],\"woocommerceHandPickedProducts\":[]},\"tagName\":\"div\",\"displayLayout\":{\"type\":\"flex\",\"columns\":4,\"shrinkColumns\":true},\"dimensions\":{\"widthType\":\"fill\"},\"queryContextIncludes\":[\"collection\"]} -->\n<div class=\"wp-block-woocommerce-product-collection\"><!-- wp:woocommerce/product-template -->\n<!-- wp:woocommerce/product-image {\"showSaleBadge\":false,\"imageSizing\":\"thumbnail\",\"isDescendentOfQueryLoop\":true} -->\n<!-- wp:woocommerce/product-sale-badge {\"isDescendentOfQueryLoop\":true,\"align\":\"right\"} /-->\n<!-- /wp:woocommerce/product-image -->\n\n<!-- wp:post-title {\"textAlign\":\"center\",\"level\":3,\"isLink\":true,\"__woocommerceNamespace\":\"woocommerce/product-collection/product-title\"} /-->\n\n<!-- wp:woocommerce/product-price {\"isDescendentOfQueryLoop\":true,\"textAlign\":\"center\"} /-->\n\n<!-- wp:woocommerce/product-button {\"textAlign\":\"center\",\"isDescendentOfQueryLoop\":true} /-->\n<!-- /wp:woocommerce/product-template --></div>\n<!-- /wp:woocommerce/product-collection --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"rida-pb\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide rida-pb\"><!-- wp:html -->\n<div class=\"rida-season\">\n<a class=\"rida-reveal\" href=\"https://rida-art.ru/product-category/mush/\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/osennyaya-girlyanda.jpg\" alt=\"Осенняя гирлянда из деревянных грибов и желудей\" loading=\"lazy\" width=\"864\" height=\"864\"><div><small>Осенняя коллекция</small><b>Грибы, жёлуди и гирлянды</b><span>Уютный декор для долгих осенних вечеров →</span></div></a>\n<a class=\"rida-reveal\" href=\"https://rida-art.ru/product-category/spring/\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/mimoza-i-yaytsa-768x1024.jpg\" alt=\"Расписные пасхальные яйца на веточках мимозы\" loading=\"lazy\" width=\"768\" height=\"1024\"><div><small>Весенняя коллекция</small><b>Пасхальные яйца и ангелы</b><span>Стекло, дерево и фарфор с ручной росписью →</span></div></a>\n</div>\n<!-- /wp:html --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"rida-corp\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide rida-corp\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(28px,4vw,56px)\",\"bottom\":\"clamp(28px,4vw,56px)\",\"left\":\"clamp(22px,4vw,64px)\",\"right\":\"clamp(22px,4vw,64px)\"},\"blockGap\":{\"left\":\"clamp(2rem,5vw,5rem)\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\" style=\"padding-top:clamp(28px,4vw,56px);padding-right:clamp(22px,4vw,64px);padding-bottom:clamp(28px,4vw,56px);padding-left:clamp(22px,4vw,64px)\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"56%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:56%\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\",\"style\":{\"color\":{\"text\":\"#e9d3a3\"}}} -->\n<p class=\"rida-eyebrow has-text-color\" style=\"color:#e9d3a3\">Для компаний</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"clamp(2rem,3.4vw,3rem)\"}}} -->\n<h2 class=\"wp-block-heading\" style=\"font-size:clamp(2rem,3.4vw,3rem)\">Корпоративные подарки, <em>которые хранят</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Игрушки-талисманы для сотрудников, клиентов и партнёров: в фирменных цветах, с вашей символикой и упаковкой. В отличие от ручек и календарей, они не теряются — живут годами на полках и напоминают о вас с теплом.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"rida-btn-gold\"} -->\n<div class=\"wp-block-button rida-btn-gold\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rida-art.ru/korporativ/\">Обсудить заказ</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"44%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:44%\"><!-- wp:image {\"id\":310,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://rida-art.ru/wp-content/uploads/2026/10/podarochnye-korobki.jpg\" alt=\"Наборы игрушек ручной работы в подарочных коробках\" class=\"wp-image-310\" loading=\"lazy\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"rida-py\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide rida-py\"><!-- wp:group {\"className\":\"rida-section-head rida-reveal\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group rida-section-head rida-reveal\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\"} -->\n<p class=\"rida-eyebrow\">Журнал</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Истории <em>и идеи подарков</em></h2>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"rida-link-arrow\"} -->\n<p class=\"rida-link-arrow\"><a href=\"https://rida-art.ru/zhurnal/\">Все статьи</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:query {\"queryId\":21,\"query\":{\"perPage\":3,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"author\":\"\",\"search\":\"\",\"exclude\":[],\"sticky\":\"\",\"inherit\":false},\"className\":\"rida-posts\"} -->\n<div class=\"wp-block-query rida-posts\"><!-- wp:post-template {\"layout\":{\"type\":\"grid\",\"columnCount\":3}} -->\n<!-- wp:post-featured-image {\"isLink\":true,\"aspectRatio\":\"4/3\"} /-->\n\n<!-- wp:group {\"className\":\"rida-post-body\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group rida-post-body\"><!-- wp:post-date {\"className\":\"rida-muted\",\"fontSize\":\"small\"} /-->\n\n<!-- wp:post-title {\"level\":3,\"isLink\":true} /-->\n\n<!-- wp:post-excerpt {\"excerptLength\":22} /--></div>\n<!-- /wp:group -->\n<!-- /wp:post-template --></div>\n<!-- /wp:query --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"rida-pb\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide rida-pb\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"clamp(1.5rem,4vw,4rem)\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"50%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:50%\"><!-- wp:paragraph {\"className\":\"rida-eyebrow\"} -->\n<p class=\"rida-eyebrow\">Приходите в гости</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Мастерская <em>в Ростокино</em></h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"rida-lead\"} -->\n<p class=\"rida-lead\">Игрушки можно забрать самостоятельно — по предварительной договорённости. Напишите или позвоните, и мы подготовим ваш заказ.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"50%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center rida-reveal\" style=\"flex-basis:50%\"><!-- wp:html -->\n<div class=\"rida-contact-card\">\n<p><strong>Адрес:</strong> Москва, м. «Ростокино», ул. Енисейская, д. 2, стр. 2 · <a href=\"https://yandex.ru/maps/?pt=37.67007,55.851935&amp;z=16&amp;l=map\" target=\"_blank\" rel=\"noopener\">на карте</a></p>\n<p><strong>Часы работы:</strong> пн–пт 10:00–18:00, сб–вс — выходные</p>\n<p><strong>Телефон:</strong> <a href=\"tel:+79296442008\">8 (929) 644-20-08</a></p>\n<p><strong>Telegram:</strong> <a href=\"https://t.me/rida_art_i\" target=\"_blank\" rel=\"noopener\">@rida_art_i</a> · <strong>E-mail:</strong> <a href=\"mailto:ssonle@mail.ru\">ssonle@mail.ru</a></p>\n</div>\n<!-- /wp:html --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n"}
